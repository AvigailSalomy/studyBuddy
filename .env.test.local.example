# Two dedicated, real Supabase Auth accounts used by the automated test
# suite (Vitest integration tests + Playwright e2e tests). Create them
# once by hand in the existing Supabase project: sign up normally,
# click the verification link that arrives by email, then complete
# onboarding for both. Do NOT reuse your own personal account.
#
# TEST_USER_A plays the "Owner" role in tests (creates groups).
# TEST_USER_B plays the "joining member" role (sends join requests,
# gets approved, becomes a member).
#
# This file is gitignored (.env* in .gitignore) -- copy it to
# .env.test.local and fill in real values there. Never commit real
# credentials.

TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=

TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
